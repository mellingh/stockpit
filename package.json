{
  "name": "stockpit",
  "version": "2.0.0",
  "description": "Zentrales Dashboard für dein Aktienportfolio — Kurse, Kennzahlen, Analysten, News mit lokaler KI-Bewertung. Ohne Abos, ohne API-Keys.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "npm run build --prefix web",
    "web:install": "npm install --prefix web --no-audit --no-fund",
    "dev:web": "npm run dev --prefix web"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0",
    "yahoo-finance2": "^4.0.0"
  }
}
